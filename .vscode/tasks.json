{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++20",
                "/I${workspaceFolder}\\include",
                "/Fo${workspaceFolder}\\bin\\",
                "/Fd${workspaceFolder}\\bin\\",
                "/Fe${workspaceFolder}\\bin\\main.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\OrderBook.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles OrderBook with MSVC C++20 straight into bin/"
        }
    ]
}